CREATE TABLE note (
    local_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    remote_id INTEGER UNIQUE,
    etag TEXT,
    title TEXT NOT NULL,
    category TEXT NOT NULL,
    content TEXT,
    favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    modified INTEGER NOT NULL,
    readonly INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    hidden INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    sync_state TEXT NOT NULL DEFAULT 'SYNCED' CHECK (sync_state IN ('SYNCED', 'DIRTY', 'NEW', 'DELETED')),
    conflict_of INTEGER,
    -- First meaningful line of content, computed in Kotlin (excerptOf) on every write that sets content.
    -- Last, like the column 2.sqm adds, so that fresh and migrated tables have the same column order.
    excerpt TEXT,
    -- The text a New note was created with (3.sqm): while content still equals it, the Note is untouched and the
    -- push may drop it in favour of a server Note with the same title (ADR 0006). NULL once SYNCED, and for Conflict
    -- copies and rows from before M5 (never dropped).
    created_from TEXT,
    -- The Reading position (4.sqm): the source line at the top of the Note screen when the user last left it.
    -- Local only: sync never writes it.
    view_line INTEGER
);

-- (category, title) serves the Folder lookups of Tree mode, Today, the Calendar and the creation check (M5/M6).
CREATE INDEX note_category_title ON note(category, title);
CREATE INDEX note_sync_state ON note(sync_state);

-- Search index (ADR 0007), kept in sync by the triggers below. Same statements as migrations/2.sqm.
CREATE VIRTUAL TABLE note_fts USING fts4(
    content='note',
    title,
    content,
    category,
    tokenize=unicode61 "remove_diacritics=1"
);

-- External content: FTS4 reads the old values from `note`, so deletes run BEFORE and inserts AFTER.
-- Only title, content and category re-index: markSynced, favorite, hidden and excerpt updates do not.
-- DELETED rows stay in the index; every search query joins `note` and filters them out.
CREATE TRIGGER note_fts_before_delete BEFORE DELETE ON note BEGIN
    DELETE FROM note_fts WHERE docid = old.local_id;
END;
CREATE TRIGGER note_fts_before_update BEFORE UPDATE OF title, content, category ON note
WHEN old.title IS NOT new.title OR old.content IS NOT new.content OR old.category IS NOT new.category BEGIN
    DELETE FROM note_fts WHERE docid = old.local_id;
END;
CREATE TRIGGER note_fts_after_update AFTER UPDATE OF title, content, category ON note
WHEN old.title IS NOT new.title OR old.content IS NOT new.content OR old.category IS NOT new.category BEGIN
    INSERT INTO note_fts(docid, title, content, category) VALUES (new.local_id, new.title, new.content, new.category);
END;
CREATE TRIGGER note_fts_after_insert AFTER INSERT ON note BEGIN
    INSERT INTO note_fts(docid, title, content, category) VALUES (new.local_id, new.title, new.content, new.category);
END;

-- Insert or refresh a Note from server metadata. A Note with pending local changes
-- (sync_state other than SYNCED) is left untouched, and a changed etag clears the
-- content so that selectNeedingContent picks it up. The excerpt is kept: the old one beats a blank row until
-- updateContent brings the new text.
upsertFromServer:
INSERT INTO note(remote_id, etag, title, category, favorite, modified, readonly, hidden, sync_state)
VALUES (:remoteId, :etag, :title, :category, :favorite, :modified, :readonly, :hidden, 'SYNCED')
ON CONFLICT(remote_id) DO UPDATE SET
    content = CASE WHEN note.etag IS excluded.etag THEN note.content ELSE NULL END,
    etag = excluded.etag,
    title = excluded.title,
    category = excluded.category,
    favorite = excluded.favorite,
    modified = excluded.modified,
    readonly = excluded.readonly,
    hidden = excluded.hidden
WHERE note.sync_state = 'SYNCED';

selectByRemoteId:
SELECT * FROM note WHERE remote_id = ?;

selectByLocalId:
SELECT * FROM note WHERE local_id = ?;

selectAllRemoteIds:
SELECT remote_id FROM note WHERE remote_id IS NOT NULL;

-- Light index of the synced Notes (no content), for the pull diff against the server id set.
selectSyncIndex:
SELECT local_id, remote_id, category, sync_state FROM note WHERE remote_id IS NOT NULL;

-- Pull: download of a SYNCED note's text. Never overwrites a local edit.
updateContent:
UPDATE note SET content = :content, excerpt = :excerpt, etag = :etag WHERE local_id = :localId AND sync_state = 'SYNCED';

selectNeedingContent:
SELECT local_id, remote_id, title, category FROM note WHERE content IS NULL AND sync_state != 'DELETED' AND remote_id IS NOT NULL;

selectDirty:
SELECT * FROM note WHERE sync_state IN ('DIRTY', 'NEW', 'DELETED') ORDER BY local_id;

-- Editor save (NoteEditor). Refused (0 rows) when the row's etag is no longer the one the text was based on and the row
-- no longer holds the text the edit was based on (:baseText), or the row's content was cleared by a pull. A NEW row has a
-- NULL etag on both sides. The text clause covers our own push: it changes the etag, not the text.
saveEdit:
UPDATE note
SET content = :content,
    excerpt = :excerpt,
    modified = :modified,
    sync_state = CASE WHEN sync_state = 'NEW' THEN 'NEW' ELSE 'DIRTY' END
WHERE local_id = :localId AND sync_state != 'DELETED' AND readonly = 0
  AND content IS NOT NULL AND (etag IS :baseEtag OR content = :baseText);

selectForEditor:
SELECT local_id, remote_id, etag, title, category, content, favorite, modified, readonly, hidden, sync_state, conflict_of
FROM note WHERE local_id = ?;

selectConflictCopyOf:
SELECT local_id, title FROM note WHERE conflict_of = ? AND sync_state != 'DELETED' ORDER BY local_id DESC LIMIT 1;

-- A new Note or Conflict copy in a Hidden folder is hidden at once (same prefix rule as FolderPrefix.kt).
-- createdFrom is the initial text of a creation, NULL for a Conflict copy.
insertNew:
INSERT INTO note(title, category, content, excerpt, favorite, modified, hidden, sync_state, conflict_of, created_from)
VALUES (:title, :category, :content, :excerpt, 0, :modified, EXISTS (
    SELECT 1 FROM folder_exclusion e
    WHERE e.kind = 'HIDDEN'
      AND (:category = e.prefix OR substr(:category, 1, length(e.prefix) + 1) = e.prefix || '/')
), 'NEW', :conflictOf, :createdFrom);

-- Hidden folders changed: recompute the flag of every row, whatever its sync_state (same prefix rule as insertNew).
-- Does not touch title, content or category, so it does not re-index.
recomputeHidden:
UPDATE note SET hidden = EXISTS (
    SELECT 1 FROM folder_exclusion e
    WHERE e.kind = 'HIDDEN'
      AND (note.category = e.prefix OR substr(note.category, 1, length(e.prefix) + 1) = e.prefix || '/')
);

lastInsertedLocalId:
SELECT last_insert_rowid();

-- Push: the server accepted the sent version. Compares the row with what was sent and writes in one statement
-- (every SET reads the old row), so an edit made during the request is kept: title and category follow the server
-- (which may rename a duplicate to "Title (2)") only where they still equal what was sent, a changed row stays
-- DIRTY with its modified time, and a DELETED row stays DELETED, now with the remote id. A Favorite toggled during
-- the request also keeps the row DIRTY, so the next push sends it. created_from is cleared: the server has the Note,
-- so the "untouched" rule no longer applies.
markSynced:
UPDATE note
SET remote_id = :remoteId,
    etag = :etag,
    created_from = NULL,
    title = CASE WHEN title = :sentTitle THEN :title ELSE title END,
    category = CASE WHEN category = :sentCategory THEN :category ELSE category END,
    modified = CASE
        WHEN sync_state != 'DELETED' AND title = :sentTitle AND category = :sentCategory AND coalesce(content, '') = :sentContent
            AND favorite = :sentFavorite
        THEN :modified ELSE modified END,
    sync_state = CASE
        WHEN sync_state = 'DELETED' THEN 'DELETED'
        WHEN title = :sentTitle AND category = :sentCategory AND coalesce(content, '') = :sentContent
            AND favorite = :sentFavorite THEN 'SYNCED'
        ELSE 'DIRTY' END
WHERE local_id = :localId;

markDeleted:
UPDATE note SET sync_state = 'DELETED' WHERE local_id = ?;

-- Note menu (NoteActions): Favorite toggle. A NEW row stays NEW; read-only and DELETED rows are refused.
setFavorite:
UPDATE note SET favorite = :favorite,
    sync_state = CASE WHEN sync_state = 'NEW' THEN 'NEW' ELSE 'DIRTY' END
WHERE local_id = :localId AND sync_state != 'DELETED' AND readonly = 0;

-- Note menu: Rename and Move in one query (either field may be unchanged). Recomputes hidden with the insertNew
-- rule. Links in other Notes are never rewritten.
renameMove:
UPDATE note SET title = :title, category = :category, modified = :modified,
    hidden = EXISTS (SELECT 1 FROM folder_exclusion e WHERE e.kind = 'HIDDEN'
        AND (:category = e.prefix OR substr(:category, 1, length(e.prefix) + 1) = e.prefix || '/')),
    sync_state = CASE WHEN sync_state = 'NEW' THEN 'NEW' ELSE 'DIRTY' END
WHERE local_id = :localId AND sync_state != 'DELETED' AND readonly = 0;

-- Note menu: Delete of a never-pushed row, which the server has never seen.
deleteNew:
DELETE FROM note WHERE local_id = ? AND sync_state = 'NEW' AND remote_id IS NULL;

-- Note menu: Delete of a row the server has; the push sends the DELETE. Read-only rows are refused.
markDeletedByUser:
UPDATE note SET sync_state = 'DELETED' WHERE local_id = ? AND sync_state != 'DELETED' AND readonly = 0;

deleteByLocalId:
DELETE FROM note WHERE local_id = ?;

-- Match the Folder itself and its sub-folders (no LIKE: '_' is common in names), so "a/b" does not match "a/bc".
deleteByCategoryPrefix:
DELETE FROM note WHERE category = :prefix OR substr(category, 1, length(:prefix) + 1) = :prefix || '/';

-- Folder refresh: SYNCED rows of exactly this Folder (no sub-folders), for the deletion diff.
selectSyncedRemoteIdsInFolder:
SELECT local_id, remote_id FROM note WHERE category = ? AND sync_state = 'SYNCED' AND remote_id IS NOT NULL;

-- List mode. No content: the list never loads note text.
selectListRows:
SELECT local_id, title, category, excerpt, favorite, modified, sync_state, conflict_of
FROM note
WHERE sync_state != 'DELETED' AND hidden = 0 AND (:favoritesOnly = 0 OR favorite = 1)
ORDER BY favorite DESC, modified DESC;

-- Tree mode: visible Notes per Folder (direct counts) and the newest of them. Kotlin builds the recursive tree
-- (buildFolderTree).
countVisibleByFolder:
SELECT category, count(*) AS notes, max(modified) AS newest
FROM note
WHERE sync_state != 'DELETED' AND hidden = 0
GROUP BY category;

-- The Folder picker: Notes per Folder, Hidden ones included (the picker lists Hidden folders, Tree mode does not).
countByFolder:
SELECT category, count(*) AS notes
FROM note
WHERE sync_state != 'DELETED'
GROUP BY category;

-- Tree mode: the Notes directly in one Folder. Uses note_category_title. Kotlin sorts them with the collator.
selectFolderNotes:
SELECT local_id, title, category, excerpt, favorite, modified, sync_state, conflict_of
FROM note
WHERE category = :category AND sync_state != 'DELETED' AND hidden = 0;

-- The Notes next to an open Note: the same Folder, and the same visibility (a Hidden Note steps among the Hidden ones
-- of its Folder, a visible one among the visible ones). Kotlin orders them like Tree mode (siblingsAround).
selectSiblings:
SELECT local_id, title, modified
FROM note
WHERE category = :category AND sync_state != 'DELETED' AND hidden = :hidden;

-- The Notes of the Journal folder, for the Calendar and Date locale detection. No hidden filter, on purpose (CLAUDE.md:
-- the Calendar sees Hidden notes, and a Hidden Journal folder still holds the Daily notes). first_line is the text
-- before the first line feed (NULL without content), so detection doesn't load whole notes.
selectJournalNotes:
SELECT local_id, title, excerpt, content IS NOT NULL AS has_content, modified,
    CASE WHEN instr(content, char(10)) > 0 THEN substr(content, 1, instr(content, char(10)) - 1) ELSE content END
        AS first_line
FROM note
WHERE category = :category AND sync_state != 'DELETED';

countNotes:
SELECT count(*) FROM note WHERE sync_state != 'DELETED';

countNotesWithContent:
SELECT count(*) FROM note WHERE content IS NOT NULL AND sync_state != 'DELETED';

-- Push: store the server's version in place of the local one (server wins on a 412).
replaceWithServer:
UPDATE note
SET title = :title, category = :category, content = :content, excerpt = :excerpt, favorite = :favorite, etag = :etag,
    modified = :modified, readonly = :readonly, sync_state = 'SYNCED'
WHERE local_id = :localId;

-- Push: the server Note is gone, keep the local text as a new Note.
resetToNew:
UPDATE note SET remote_id = NULL, etag = NULL, sync_state = 'NEW' WHERE local_id = ?;

-- Exact match: the server's title match is case-sensitive (M5 real-server check 3).
folderHasTitle:
SELECT count(*) FROM note WHERE category = :category AND title = :title AND sync_state != 'DELETED';

-- Creation check (NoteCreator): the Note at exactly this (folder, title), as the server matches it. Not the
-- resolver's selectByFolderAndTitle, which ignores case. No `hidden` filter: a Hidden Note still takes the title.
selectExactByFolderAndTitle:
SELECT local_id FROM note
WHERE category = :category AND title = :title AND sync_state != 'DELETED'
ORDER BY modified DESC LIMIT 1;

-- Push-time check (ADR 0006): the server's copy of a (folder, title), i.e. a row the server knows. Exact match, as
-- on the server.
selectServerNote:
SELECT local_id, title FROM note
WHERE category = :category AND title = :title AND remote_id IS NOT NULL AND sync_state != 'DELETED' LIMIT 1;

-- Drop an untouched NEW row; 0 rows when it was edited in the meantime (then it becomes a Conflict copy).
dropIfUntouched:
DELETE FROM note WHERE local_id = ? AND sync_state = 'NEW' AND remote_id IS NULL
  AND created_from IS NOT NULL AND coalesce(content, '') = created_from;

-- Push-time check: a NEW row whose title the server already has becomes a Conflict copy of the server Note.
convertToConflictCopy:
UPDATE note SET title = :title, conflict_of = :conflictOf, created_from = NULL
WHERE local_id = :localId AND sync_state = 'NEW' AND remote_id IS NULL;

countConflictCopies:
SELECT count(*) FROM note WHERE conflict_of IS NOT NULL AND sync_state != 'DELETED';

-- Settings: the Folders known locally (Notes at the Vault root have an empty category).
selectDistinctCategories:
SELECT DISTINCT category FROM note WHERE category != '' AND sync_state != 'DELETED' ORDER BY category;

-- Notes in the Folder or below it, for the "delete local Notes" confirm. Pending ones are kept by the sync.
countUnderPrefix:
SELECT count(*) FROM note
WHERE sync_state != 'DELETED' AND (category = :prefix OR substr(category, 1, length(:prefix) + 1) = :prefix || '/');

countPendingUnderPrefix:
SELECT count(*) FROM note
WHERE sync_state IN ('DIRTY', 'NEW') AND (category = :prefix OR substr(category, 1, length(:prefix) + 1) = :prefix || '/');

-- Excerpt backfill after the migration, and safety net at startup (ExcerptBackfill).
selectMissingExcerpt:
SELECT local_id, title, content FROM note WHERE excerpt IS NULL AND content IS NOT NULL;

setExcerpt:
UPDATE note SET excerpt = :excerpt WHERE local_id = :localId;

-- Search, step 2: snippets of the content for one page of visible results (NoteSearch). Markers are char(2) and
-- char(3). Selects note.local_id through the join: SQLDelight cannot compile a query that selects note_fts.docid.
-- Step 1, the hits with matchinfo(), is in NoteSearch: SQLDelight does not know matchinfo().
searchSnippets:
SELECT note.local_id, snippet(note_fts, char(2), char(3), '…', 1, 12) AS snippet
FROM note_fts JOIN note ON note.local_id = note_fts.docid
WHERE note_fts MATCH :match AND note.local_id IN :ids;

-- Wikilink resolution (LinkResolver). No `hidden` filter: Hidden folders resolve. The first match is the most recent.
selectByFolderAndTitle:
SELECT local_id FROM note
WHERE category = :category COLLATE NOCASE AND title = :title COLLATE NOCASE AND sync_state != 'DELETED'
ORDER BY modified DESC LIMIT 1;

selectByTitle:
SELECT local_id, category FROM note WHERE title = :title COLLATE NOCASE AND sync_state != 'DELETED' ORDER BY modified DESC;

-- Link autocomplete: title matches from note_fts (the caller ranks and keeps the best 8), and the empty prefix.
suggestTitles:
SELECT note.local_id, note.title, note.category, note.modified FROM note
JOIN note_fts ON note.local_id = note_fts.docid
WHERE note_fts MATCH ? AND note.sync_state != 'DELETED'
ORDER BY note.modified DESC LIMIT 500;

selectRecentForSuggest:
SELECT local_id, title, category FROM note WHERE sync_state != 'DELETED' ORDER BY modified DESC LIMIT 8;

-- Favorites widget: the Drawer > Favorites set, without the columns the widget does not draw.
-- Hidden is filtered inline, like every List, Tree and Search query.
selectFavoriteWidgetRows:
SELECT local_id, title, category
FROM note
WHERE sync_state != 'DELETED' AND hidden = 0 AND favorite = 1
  -- A Note under an Unsynced folder leaves the widget at once; the pull deletes the row later.
  AND NOT EXISTS (
    SELECT 1 FROM folder_exclusion e
    WHERE e.kind = 'UNSYNCED'
      AND (note.category = e.prefix OR substr(note.category, 1, length(e.prefix) + 1) = e.prefix || '/')
  )
ORDER BY modified DESC;

-- Note and Daily note widgets. No hidden filter: a Note picked through Search can live in a Hidden folder.
selectNoteWidget:
SELECT title, category, content, view_line
FROM note
WHERE local_id = ? AND sync_state != 'DELETED';

setViewLine:
UPDATE note SET view_line = :line WHERE local_id = :localId;

selectViewLine:
SELECT view_line FROM note WHERE local_id = ?;
