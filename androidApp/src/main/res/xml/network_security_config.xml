<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext to any host: credentials and notes only travel over https (SEC-03). System CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
